{
  "id": "helloworld",
  "name": "Hello World",
  "version": "1.0.0",
  "description": "A minimal BranchKit plugin that types a greeting at the cursor.",
  "author": "Your Name",
  "privileges": ["input"],
  "run": "./hello-plugin",
  "action_prefix": "helloworld",
  "action_types": {
    "greet": {
      "label": "Greet",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "field_type": "string"
        }
      ]
    }
  },
  "collection_data": {
    "voice_commands": "commands.json",
    "keybinds": {
      "alt+shift+h": "helloworld greet"
    }
  },
  "implements": {
    "on_action": true,
    "render_settings": true,
    "settings_tabs": [
      { "label": "Getting Started", "key": "getting_started" }
    ]
  }
}
