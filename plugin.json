{
  "$schema": "https://branchkit.dev/schemas/manifest.json",
  "id": "helloworld",
  "name": "Helloworld",
  "version": "0.1.0",
  "min_api_version": "0.1.0",
  "description": "A BranchKit plugin",
  "author": "Your Name",
  "privileges": ["input"],
  "dev": {
    "build": [
      ["go", "build", "-o", "../helloworld-plugin", "."]
    ],
    "build_dir": "src"
  },
  "run": "./helloworld-plugin",
  "action_prefix": "helloworld",
  "action_types": {
    "greet": {
      "label": "Greet",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "field_type": "string"
        }
      ]
    }
  },
  "consumes": {
    "collections": ["apps"]
  },
  "collection_data": {
    "voice_commands": "commands.json",
    "keybinds": {
      "alt+shift+h": { "action": "helloworld.greet", "params": { "name": "BranchKit" } }
    }
  },
  "implements": {
    "on_action": true,
    "render_settings": true,
    "settings_tabs": [
      { "label": "Getting Started", "key": "getting_started" }
    ]
  }
}
